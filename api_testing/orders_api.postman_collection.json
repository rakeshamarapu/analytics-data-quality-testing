{
  "info": {
    "name": "Analytics Orders API tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "TC-19 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response time under 1000 ms\", function () { pm.expect(pm.response.responseTime).to.be.below(1000); });",
              "pm.test(\"Status field is ok\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-20 List orders (default)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Returns 10 orders\", function () { pm.expect(pm.response.json().orders.length).to.eql(10); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-21 Limit 1 (boundary)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders?limit=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders"
          ],
          "query": [
            {
              "key": "limit",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Returns 1 order\", function () { pm.expect(pm.response.json().orders.length).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-21 Limit 0 (invalid)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders?limit=0",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders"
          ],
          "query": [
            {
              "key": "limit",
              "value": "0"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"Body has an error message\", function () { pm.expect(pm.response.json()).to.have.property(\"error\"); });"
            ]
          }
        }
      ]
    },
