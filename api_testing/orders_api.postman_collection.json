    {
      "name": "TC-23 Order 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "1"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"order_total equals quantity x unit_price\", function () { const o = pm.response.json(); pm.expect(o.order_total).to.be.closeTo(o.quantity * o.unit_price, 0.01); });"
            ]
          }
        }
      ]
    },
