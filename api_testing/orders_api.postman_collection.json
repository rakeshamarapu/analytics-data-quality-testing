          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Country is standardized\", function () { pm.expect([\"India\",\"USA\",\"UK\",\"Germany\",\"Unknown\"]).to.include(pm.response.json().country); });"
            ]
          }
        }
      ]
